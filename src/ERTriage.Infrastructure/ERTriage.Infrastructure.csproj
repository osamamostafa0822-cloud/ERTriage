<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ERTriage.Domain\ERTriage.Domain.csproj" />
    <ProjectReference Include="..\ERTriage.Application\ERTriage.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- IConfiguration / GetConnectionString for AddInfrastructure(configuration). -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <!-- Security pin (D-49). EF SqlServer -> Microsoft.Data.SqlClient -> System.Security.Cryptography.Pkcs resolves to an affected
         version (9.0.4 today, 9.0.11 with SqlClient 6.1.7): GHSA-846f-f764-76mx (High), GHSA-2fmv-rv2c-59x7 (Moderate); fixed in 10.0.13.
         Remove this line once the SqlClient version in use requires a fixed Pkcs. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Development seed data (D-58): copied to the build and publish output of this project and of every project that
         references it (the Api), at Persistence/Seed/Data/fictional-patients.json. -->
    <None Update="Persistence\Seed\Data\fictional-patients.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Seed loader/validator/factory are internal; their tests live in the integration test project. -->
    <InternalsVisibleTo Include="ERTriage.Api.IntegrationTests" />
  </ItemGroup>

</Project>
